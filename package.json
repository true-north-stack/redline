{
  "name": "redline-dev",
  "private": true,
  "description": "Dev-only tooling for Redline (tests). Host projects copy files from component/ and scripts/; they don't install this.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:stack": "bash dev/test-stack.sh",
    "test:all": "bash -c 'set -a; . .redline-stack/test.env; set +a; playwright test \"$@\"' --",
    "lint": "eslint component"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/cli": "4.1.18",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "lucide-react": "0.544.0",
    "modern-screenshot": "4.6.8",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.2"
  }
}
